        {"test": "Assay (anhydrous basis)", "type": "numeric", "min": 99.5, "max": 100.5, "unit": "%"},
        {"test": "Water (Karl Fischer)", "type": "numeric", "max": 0.4, "unit": "%"},
        {"test": "Sulfated ash", "type": "numeric", "max": 0.05, "unit": "%"},
